# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (in this infra/ directory) before running compose.
#   cp .env.example .env
# Docker Compose auto-loads .env from its own directory.
# NEVER commit the real .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_DB=ekp
POSTGRES_USER=ekp
POSTGRES_PASSWORD=ekp_local_dev_password
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── MinIO (S3-compatible object storage) ──
MINIO_ROOT_USER=ekp_minio
MINIO_ROOT_PASSWORD=ekp_minio_local_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=ekp-documents

# ── Backend ──
BACKEND_PORT=8080
# Use the JSON logging profile inside containers (structured logs).
SPRING_PROFILES_ACTIVE=json
LOG_LEVEL_APP=INFO

# ── Security / JWT ──
# Generate a strong secret, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-base64-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# First-run admin bootstrap (created on startup if no admin exists).
ADMIN_EMAIL=admin@ekp.local
ADMIN_PASSWORD=change-me-strong-admin-password

# ── Frontend ──
FRONTEND_PORT=3000

# ── Embeddings (Phase 5: used by the embedding pipeline + semantic search) ──
# Off by default: without a key, documents are chunked and stored un-embedded,
# and the pipeline embeds them automatically once you set a key and enable this.
EMBEDDINGS_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 1536-dim model matches the vector() column; changing dims needs a new migration.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=96
EMBEDDING_RPM=3000

# ── RAG answer generation (Phase 6: uses the same OPENAI_API_KEY) ──
GENERATION_ENABLED=false
GENERATION_MODEL=gpt-4o-mini
GENERATION_MAX_TOKENS=800

# ── AI generation providers (templated for the answer-synthesis phase) ──
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
