# Frontend environment template.
# Copy to `.env.local` for local overrides. All Vite client vars MUST be
# prefixed with VITE_ to be exposed to the browser.

# Base URL for API calls. Leave EMPTY to use same-origin relative paths
# (recommended): in dev, Vite proxies /api and /actuator to the backend;
# in Docker, nginx reverse-proxies them. Only set this if you point the SPA
# at a backend on a different origin.
VITE_API_BASE_URL=

# Dev-only: override the proxy target used by Vite (defaults to localhost:8080).
# VITE_PROXY_TARGET=http://localhost:8080
